  "categories": [
    {
      "id": "routine",
      "prefix": "rtn",
      "title": "Routine and daily life",
      "theme": "Commutes, regular meals, the same seat, errands, and the small variations and broken routines where story starts."
    },
    {
      "id": "work",
      "prefix": "wrk",
      "title": "Work and money",
      "theme": "Shifts, a bad day, overtime, side gigs, debts, payday, and the job that ends or begins."
    },
    {
      "id": "home",
      "prefix": "hom",
      "title": "Home and household",
      "theme": "Cohabitants, chores, a lockout, a broken appliance, a landlord, and moving things in or out."
    },
    {
      "id": "family",
      "prefix": "fam",
      "title": "Family",
      "theme": "Siblings, parents visiting, a family dinner, a disagreement, looking after someone."
    },
    {
      "id": "friends",
      "prefix": "fri",
      "title": "Friendship",
      "theme": "Regular meetups, a new friend, a favor, drifting apart, a falling out and making up."
    },
    {
      "id": "romance",
      "prefix": "rom",
      "title": "Romance and dating",
      "theme": "A first date, a crush, a breakup, a partner others do not know about, an ex reappearing. Cozy, never explicit."
    },
    {
      "id": "neighbors",
      "prefix": "nbr",
      "title": "Neighbors and community",
      "theme": "Borrowing, a noise feud, carrying things for each other, a block gathering, the stall keeper who knows everyone."
    },
    {
      "id": "secrets",
      "prefix": "sec",
      "title": "Secrets and misunderstandings",
      "theme": "The ambiguity setups and their reveals. Each setup leaves at least two truths open and has a reveal for every one."
    },
    {
      "id": "conflict",
      "prefix": "cnf",
      "title": "Conflict and rivalry",
      "theme": "Arguments, grudges, competition over a stall spot or a job, and the confrontation that never comes."
    },
    {
      "id": "nightlife",
      "prefix": "ngt",
      "title": "Nightlife",
      "theme": "The club, a bar regular, a night out going wrong, a turn away at the door, a late walk home."
    },
    {
      "id": "law",
      "prefix": "law",
      "title": "The street and the law",
      "theme": "Muggings, lurkers and police seen from the edges: a victim afterward, a witness, someone avoiding the station, a lurker with a day job."
    },
    {
      "id": "weather",
      "prefix": "wth",
      "title": "Weather and the city",
      "theme": "Rain changes plans, a metro delay, a long night, the city's moods."
    },
    {
      "id": "city",
      "prefix": "cty",
      "title": "The player's city",
      "theme": "Reactions to what the player builds, plus displacement and closures: homes demolished, workplaces removed, new people moving in."
    },
    {
      "id": "milestones",
      "prefix": "mil",
      "title": "Milestones",
      "theme": "A new job, moving out, a birthday, a farewell, someone new arriving."
    },
    {
      "id": "quiet",
      "prefix": "qui",
      "title": "Quiet moments",
      "theme": "Pure texture with no consequences: a plant, the rain, a stray, a long time on a bench."
    }
  ],
